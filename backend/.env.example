PORT=8080
# Commerce Strategy: 'rule-based' | 'ai-gemini' | 'hybrid'
COMMERCE_STRATEGY=hybrid

# Google Gemini API Key (optional - falls back to deterministic rules if omitted)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Firebase Admin SDK Configuration (Optional - embedded zero-config Firestore is active by default)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIRESTORE_EMULATOR_HOST=localhost:8080
